# Swing/orchestration settings only. Provider and exchange credentials belong
# to the canonical Sjagil/crypto checkout configured by CRYPTO_REPO_PATH.
CRYPTO_REPO_PATH=../crypto
CRYPTO_SWING_CONFIG=config/swing.yaml
CRYPTO_SWING_MODE=shadow

# The canonical crypto .env is authoritative for every engine-owned key.
# Only CRYPTO_SWING_* variables remain owned by this repository.
CRYPTO_SWING_CANONICAL_ENV_PRECEDENCE=canonical

# Do not copy provider secrets into this repository. Put them in ../crypto/.env.
# The canonical stack currently recognises, among others:
# COINMARKETCAP_API_KEY / CMC_API_KEY
# EODHD_API_KEY / EOD_API_KEY / EODHISTORICALDATA_API_KEY
# FRED_API_KEY
# SEC_USER_AGENT
# DUNE_API_KEY
# COINPAPRIKA_API_KEY
# FMP_API_KEY
# TWELVEDATA_API_KEY
# ALPHAVANTAGE_API_KEY
# FINNHUB_API_KEY
# MARKETSTACK_API_KEY
# THETA_DATA_API_KEY
# FISCAL_API_KEY
# CURRENT_NEWS_API_KEY
# MARKETAUX_API_TOKEN
# OPENFIGI_API_KEY
# OPENEXCHANGERATES_APP_ID
# POLYGON_API_KEY
# BITVAVO_DATA_API_KEY / BITVAVO_DATA_API_SECRET
# BITVAVO_TRADE_API_KEY / BITVAVO_TRADE_API_SECRET
# VENUE_A_API_KEY / VENUE_A_API_SECRET (canonical aliases)
# TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID

# Live execution remains entirely governed by Sjagil/crypto and stays fail-closed.
# This repository never grants live authority and never stores withdrawal credentials.
