[Unit]
Description=CoinMarketCap Selective WebSocket Collector
Wants=network-online.target
After=network-online.target crypto-cmc-intelligence.service
RequiresMountsFor=/mnt/data

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/sjagil/crypto
Environment=PYTHONUNBUFFERED=1
Environment=CMC_STARTUP_ROOT=/mnt/data/crypto/cmc-startup
Environment=CRYPTO_SWING_PRODUCTION_MODE=shadow
Environment=CRYPTO_SWING_CANARY_EXECUTE=NO
Environment=CRYPTO_SWING_FULL_LIVE=NO
Environment=CRYPTO_FULL_LIVE=NO
ExecStart=/home/pi/sjagil/crypto-ai-swing-layer/.venv/bin/python /home/pi/sjagil/crypto/scripts/cmc_startup_intelligence.py --markets-file /home/pi/sjagil/crypto-ai-swing-layer/output/crypto_ai_swing/universe/latest.json websocket
Restart=always
RestartSec=15
TimeoutStopSec=30
Nice=10
CPUQuota=50%
MemoryHigh=512M
MemoryMax=1G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/pi/sjagil/crypto/data_store /mnt/data

[Install]
WantedBy=multi-user.target
