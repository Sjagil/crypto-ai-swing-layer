[Unit]
Description=Crypto Swing Full Live Quant/AI Runtime
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/sjagil/crypto-ai-swing-layer

Environment=PYTHONUNBUFFERED=1
Environment=CRYPTO_REPO_PATH=/home/pi/sjagil/crypto
Environment=CRYPTO_FULL_LIVE=YES
Environment=CRYPTO_SWING_FULL_LIVE=YES
Environment=CRYPTO_SWING_PRODUCTION_MODE=live

# These are emergency circuit-breaker ceilings. Canonical RiskManager + Kelly +
# correlation + cost/edge logic normally size far below them.
Environment=CRYPTO_FULL_LIVE_MAXIMUM_ORDER_EUR=100000
Environment=CRYPTO_FULL_LIVE_MAXIMUM_EXPOSURE_EUR=250000
Environment=CRYPTO_FULL_LIVE_MAXIMUM_POSITIONS=5
Environment=CRYPTO_FULL_LIVE_MAXIMUM_NEW_ORDERS_PER_DAY=12
Environment=CRYPTO_FULL_LIVE_MAXIMUM_RISK_EUR=5000

ExecStart=/home/pi/sjagil/crypto-ai-swing-layer/.venv/bin/python -m crypto_ai_swing.cli proactive --mode live --interval-seconds 60
Restart=always
RestartSec=10
TimeoutStopSec=60
KillSignal=SIGTERM
Nice=5

[Install]
WantedBy=multi-user.target
